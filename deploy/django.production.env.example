# Template only. Inject real values privately, with a dedicated SQL account.
DJANGO_SETTINGS_MODULE=main_admin.production_settings
MAIN_PUBLIC_ORIGIN=https://main.example.org
MAIN_DJANGO_SECRET_KEY=
MAIN_DB_HOST=127.0.0.1
MAIN_DB_PORT=3306
MAIN_DB_NAME=main
MAIN_DB_USER=main_django
MAIN_DB_PASSWORD=
# Keep this empty for a same-host database. A remote host requires an existing CA file;
# startup fails closed and uses VERIFY_IDENTITY instead of transmitting credentials insecurely.
MAIN_DB_SSL_CA=
# Audio/video moderation stays disabled until policy and provider use are approved.
MAIN_MODERATION_MEDIA_ENABLED=false
MAIN_FFMPEG_EXECUTABLE=
MAIN_FFPROBE_EXECUTABLE=
# Launch Waitress on loopback, trusting only 127.0.0.1 and x-forwarded-proto.
