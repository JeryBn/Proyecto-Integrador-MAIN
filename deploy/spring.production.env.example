# Template only. Supply actual secrets privately to the service, never commit them.
# Do not source the development .env.local in the deployment directory.
SPRING_PROFILES_ACTIVE=production
MAIN_DB_HOST=db.example.org
MAIN_DB_PORT=3306
MAIN_DB_NAME=main
MAIN_DB_USER=main_spring
MAIN_DB_PASSWORD=
SPRING_FLYWAY_USER=main_migration
SPRING_FLYWAY_PASSWORD=
# JVM must trust the database CA; VERIFY_IDENTITY also checks its hostname.
# Do not set demo/admin bootstrap passwords or downgrade the database TLS mode.
