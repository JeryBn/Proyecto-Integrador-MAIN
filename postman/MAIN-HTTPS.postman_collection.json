        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
              "const t=pm.response.json(); pm.expect(t.token).to.be.a('string').and.not.empty; pm.collectionVariables.set('userToken',t.token); pm.collectionVariables.set('userParameter',t.parameterName);"
            ]
