  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const url=pm.variables.replaceIn(pm.request.url.toString()); if (!url.startsWith('https://')) throw new Error('Esta colección requiere HTTPS');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTPS y cabeceras del proxy',()=>{pm.expect(pm.variables.replaceIn(pm.request.url.toString())).to.match(/^https:\\/\\//); pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.include('max-age='); pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.equal('nosniff');});"
        ]
      }
    }
  ]
