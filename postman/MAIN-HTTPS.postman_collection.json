    },
    {
      "name": "06 Acceso alumno",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{userBase}}/login",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "text"
            },
            {
              "key": "{{userParameter}}",
              "value": "{{userToken}}",
              "type": "text"
            }
          ]
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado HTTP 302', () => pm.response.to.have.status(302));",
              "pm.test('Cookie de sesión segura', () => {const cookies=pm.response.headers.all().filter(h=>h.key.toLowerCase()==='set-cookie'); const c=cookies.find(h=>h.value.startsWith('JSESSIONID=')); pm.expect(c,'cookie de sesión').to.exist; pm.expect(c.value).to.match(/;\\s*Secure/i); pm.expect(c.value).to.match(/;\\s*HttpOnly/i); pm.expect(c.value).to.match(/;\\s*SameSite=Lax/i);});",
              "pm.test('Redirección permanece HTTPS',()=>{pm.expect(pm.response.headers.get('Location')).not.to.match(/^http:\\/\\//i);});"
            ]
          }
        }
      ]
    },
