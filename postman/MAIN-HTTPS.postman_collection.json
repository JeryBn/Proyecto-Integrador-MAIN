    {
      "name": "01 Acceso alumno público",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{userBase}}/login.html"
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
