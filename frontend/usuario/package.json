{
  "name": "colegia-usuario",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run stitch:styles && vite --host 0.0.0.0",
    "build": "npm run stitch:styles && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.*",
    "stitch:styles": "tailwindcss -c tailwind.stitch.cjs -i src/diseno/stitch-input.css -o src/diseno/stitch-utilities.css --minify"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "^3.4.17",
    "vite": "8.3.8"
  }
}
